{
    "manifest_version": 3,
    "name": "Frappe/ERPNext Tools",
    "description": "Simple Extension that help you work & develop with Frappe/ERPNext Framework",
    "version": "1.1.7",
    "icons": {
        "16": "logo/logo.png",
        "48": "logo/logo.png",
        "128": "logo/logo.png"
    },
    "permissions": [ "scripting", "storage" ],
    "host_permissions": [ "http://*/app/*", "https://*/app/*" ],
    "content_scripts": [{
        "js": [ "src/content/content.js", "src/lib/frappe/papaparse.min.js" ],
        "matches": [ "http://*/app/*", "https://*/app/*" ],
        "run_at": "document_end"
    }],
    "background": {
        "service_worker": "src/background/service-worker.js",
        "type": "module"
    },
    "web_accessible_resources": [
        {
          "resources": [ 
            "logo/logo.png", 
            "src/inject/form.js", 
            "src/inject/listview.js", 
            "src/inject/ui-dialogs.js", 
            "src/shared/events.js" 
          ],
          "matches": [ "*://*/*" ]
        }
      ] 
}
